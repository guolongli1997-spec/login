{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "login",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flytripvisa-db",
      "database_id": "a49b13c8-e420-48b4-8967-f9752e1bc5fa"
    }
  ],

  "vars": {
    "APP_NAME": "flytripvisa.site",
    "TOKEN_TTL_SECONDS": "2592000"
  }
}, 