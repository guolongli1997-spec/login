{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "login",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "a49b13c8-e420-48b4-8967-f9752e1bc5fa"
    }
  ],

  "vars": {
    "APP_NAME": "FlyTripVisa",
    "TOKEN_TTL_SECONDS": "2592000"
  }
}
